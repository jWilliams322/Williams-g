<?xml version="1.0" encoding="UTF-8"?>
<!-- Corrected XML declaration from <?XML to <?xml (lowercase) -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="pe.edu.upeu.asistencia.control.VentaController" 
            style="-fx-background-color: #f0f0f5;">
    
    <top>
        <VBox style="-fx-background-color: #ff6b35; -fx-padding: 25;">
            <Label text="GESTION DE VENTAS" 
                   style="-fx-text-fill: white; -fx-font-size: 26; -fx-font-weight: bold;"/>
            <Label text="Registra, procesa y analiza todas las transacciones comerciales" 
                   style="-fx-text-fill: white; -fx-font-size: 12; -fx-font-weight: bold; -fx-padding: 5 0 0 0;"/>
        </VBox>
    </top>
    
    <center>
        <VBox spacing="20" style="-fx-padding: 25;">
            
            <VBox style="-fx-border-color: #e0e0e0; -fx-background-color: white; -fx-padding: 20; -fx-border-width: 2;">
                <Label text="FORMULARIO DE VENTA" 
                       style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #ff6b35; -fx-padding: 0 0 15 0;"/>
                
                <GridPane hgap="15" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="120" prefWidth="150"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="180" prefWidth="250"/>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="120" prefWidth="150"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="180" prefWidth="250"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="35"/>
                        <RowConstraints minHeight="35"/>
                        <RowConstraints minHeight="35"/>
                    </rowConstraints>
                    
                    <Label text="Numero de Venta:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtNumero" promptText="Generado automaticamente" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-padding: 10;"/>
                    <Label text="Fecha de Venta:" style="-fx-font-weight: bold;" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <DatePicker fx:id="dpFecha" GridPane.columnIndex="3" GridPane.rowIndex="0" style="-fx-padding: 10;"/>
                    
                    <Label text="Nombre del Cliente:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtCliente" promptText="Referencia del cliente" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-padding: 10;"/>
                    <Label text="Nombre de Zapatilla:" style="-fx-font-weight: bold;" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtProducto" promptText="Referencia del zapato" GridPane.columnIndex="3" GridPane.rowIndex="1" style="-fx-padding: 10;"/>
                    
                    <Label text="Cantidad:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtCantidad" promptText="Cantidad de pares" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-padding: 10;"/>
                    <Label text="Precio Unitario:" style="-fx-font-weight: bold;" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtPrecio" promptText="0.00" GridPane.columnIndex="3" GridPane.rowIndex="2" style="-fx-padding: 10;"/>
                </GridPane>
                
                <HBox spacing="12" style="-fx-padding: 15 0 0 0;">
                    <Button text="GUARDAR VENTA" onAction="#crearVenta" 
                            style="-fx-padding: 12; -fx-font-size: 12; -fx-font-weight: bold; -fx-background-color: #ff6b35; -fx-text-fill: white;"/>
                    <Button text="LIMPIAR FORMULARIO" onAction="#limpiarFormulario" 
                            style="-fx-padding: 12; -fx-font-size: 12; -fx-font-weight: bold; -fx-background-color: #95a5a6; -fx-text-fill: white;"/>
                </HBox>
            </VBox>
            
            <HBox style="-fx-background-color: #ff6b35; -fx-padding: 20; -fx-alignment: center;">
                <Label fx:id="lblTotal" text="Total de Ventas: 0.00" 
                       style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </HBox>
            
            <VBox style="-fx-border-color: #e0e0e0; -fx-background-color: white; -fx-padding: 20; -fx-border-width: 2;" VBox.vgrow="ALWAYS">
                <Label text="HISTORIAL DE VENTAS" 
                       style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #ff6b35; -fx-padding: 0 0 15 0;"/>
                <TableView fx:id="tableView" VBox.vgrow="ALWAYS" style="-fx-font-size: 11;"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
