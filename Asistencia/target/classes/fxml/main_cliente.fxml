<?xml version="1.0" encoding="UTF-8"?>
<!-- Corrected XML declaration from <?XML to <?xml (lowercase) -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Changed javafx version from 17 to 21 for consistency -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="pe.edu.upeu.asistencia.control.ClienteController" 
            style="-fx-background-color: #f0f0f5;">
    
    <top>
        <VBox style="-fx-background-color: #2c3e50; -fx-padding: 25;">
            <Label text="GESTION DE CLIENTES" 
                   style="-fx-text-fill: white; -fx-font-size: 26; -fx-font-weight: bold;"/>
            <Label text="Administra tu base de datos de compradores y relaciones comerciales" 
                   style="-fx-text-fill: #ff6b35; -fx-font-size: 12; -fx-font-weight: bold; -fx-padding: 5 0 0 0;"/>
        </VBox>
    </top>
    
    <center>
        <VBox spacing="20" style="-fx-padding: 25;">
            
            <VBox style="-fx-border-color: #e0e0e0; -fx-background-color: white; -fx-padding: 20; -fx-border-width: 2;">
                <Label text="FORMULARIO DE CLIENTE" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-padding: 0 0 15 0;"/>
                
                <GridPane hgap="15" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="120" prefWidth="140"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="180" prefWidth="250"/>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="120" prefWidth="140"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="180" prefWidth="250"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="35"/>
                        <RowConstraints minHeight="35"/>
                        <RowConstraints minHeight="35"/>
                        <!-- Added fourth row for the direction field -->
                        <RowConstraints minHeight="35"/>
                    </rowConstraints>
                    
                    <Label text="ID Cliente:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtId" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label text="Nombre Completo:" style="-fx-font-weight: bold;" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <!-- Removed editable="false" to allow user input -->
                    <TextField fx:id="txtNombre" promptText="Ingresa nombre" GridPane.columnIndex="3" GridPane.rowIndex="0" style="-fx-padding: 10;"/>
                    
                    <Label text="Cedula:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtCedula" promptText="Numero de identificacion" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-padding: 10;"/>
                    <Label text="Ciudad:" style="-fx-font-weight: bold;" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtCiudad" promptText="Ciudad de residencia" GridPane.columnIndex="3" GridPane.rowIndex="1" style="-fx-padding: 10;"/>
                    
                    <Label text="Correo:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtEmail" promptText="correo@example.com" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-padding: 10;"/>
                    <Label text="Telefono:" style="-fx-font-weight: bold;" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtTelefono" promptText="+1-555-0000" GridPane.columnIndex="3" GridPane.rowIndex="2" style="-fx-padding: 10;"/>
                    
                    <!-- Added missing direction field that was causing NullPointerException -->
                    <Label text="Dirección:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <TextField fx:id="txtDireccion" promptText="Calle y número" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="3" style="-fx-padding: 10;"/>
                </GridPane>
                
                <HBox spacing="12" style="-fx-padding: 15 0 0 0;">
                    <Button text="GUARDAR CLIENTE" onAction="#crearCliente" 
                            style="-fx-padding: 12; -fx-font-size: 12; -fx-font-weight: bold; -fx-background-color: #2c3e50; -fx-text-fill: white;"/>
                    <Button text="LIMPIAR FORMULARIO" onAction="#limpiarFormulario" 
                            style="-fx-padding: 12; -fx-font-size: 12; -fx-font-weight: bold; -fx-background-color: #95a5a6; -fx-text-fill: white;"/>
                </HBox>
            </VBox>
            
            <VBox style="-fx-border-color: #e0e0e0; -fx-background-color: white; -fx-padding: 20; -fx-border-width: 2;" VBox.vgrow="ALWAYS">
                <Label text="BASE DE DATOS DE CLIENTES" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-padding: 0 0 15 0;"/>
                <TableView fx:id="tableView" VBox.vgrow="ALWAYS" style="-fx-font-size: 11;"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
